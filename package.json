{
  "name": "picfy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply picfy --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply picfy --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "wrangler": "^4.150.0"
  }
}
